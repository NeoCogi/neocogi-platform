#[version(1)]
/// Immutable bounded CPU image containing tightly packed row-major RGBA pixels.
///
/// The capability carries only graphics data. In particular, it exposes no UI
/// font, icon, skin, chrome, palette, or catalog metadata to renderer plugins.
interface IRgbaImage {
    /// Returns positive immutable pixel dimensions.
    fn size(&self) -> Result<Size>;
    /// Copies the exact requested byte range from tightly packed RGBA storage.
    fn pixels(&self, output: &mut [u8]) -> Result<()>;
}

#[version(1)]
/// Immutable GPU texture whose final release destroys its native allocation with its owning device alive.
interface ITexture {
    /// Returns positive immutable pixel dimensions, independent of its destination rectangle.
    fn size(&self) -> Result<Size>;
}

#[version(1)]
/// Optional renderer capability for uploading immutable external images.
interface ITextureFactory {
    /// Uploads exactly width * height * 4 RGBA bytes at offset zero.
    fn create_texture(&self, size: Size, pixels: &[u8]) -> Result<ComPtr<ITexture>>;
}

#[version(1)]
/// Independent two-dimensional rendering session on its creating renderer's device.
/// Query IRenderer to submit private UI blocks at the selected size.
interface IRenderSurface {
    /// Returns the requested physical size; a zero component suspends rendering.
    fn size(&self) -> Result<Size>;
    /// Changes the next frame's size without mutating any completed image.
    /// Negative or oversized extents fail without changing the current size.
    fn resize(&self, size: Size) -> Result<()>;
    /// Retains the last successfully completed immutable image; NC_E_NOT_FOUND precedes the first frame.
    /// A retained image remains unchanged after later renders, resize, or surface release.
    fn completed_image(&self) -> Result<ComPtr<ITexture>>;
}

#[version(2)]
/// Creates independent opaque preview surfaces without exposing native GPU handles.
interface IRenderSurfaceFactory {
    /// Creates a surface on the same device as the factory; GFX owns its private UI resources.
    /// Rendering never presents or clears the window. Output uses top-left texture coordinates
    /// and an opaque clear color; client graphics blocks are unsupported.
    /// Backends without this capability report an explicit failure.
    fn create_surface(&self, size: Size) -> Result<ComPtr<IRenderSurface>>;
}

#[version(1)]
/// Owned diagnostic snapshots preserve backend details without exposing backend-dependent errors.
interface IRenderDiagnostics {
    /// Returns the most recent failed GPU operation's detail, or empty text before a failure.
    fn diagnostic(&self) -> Result<ComPtr<INcString>>;
}
