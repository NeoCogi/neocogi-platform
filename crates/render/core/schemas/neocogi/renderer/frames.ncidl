#[version(1)]
/// Metadata for one synchronous submission of sealed generic graphics blocks.
struct RenderInfo {
    /// Positive logical drawable dimensions; native backends map them to physical pixels.
    size: Size,
    /// Packed RGBA attachment clear color, red in the least significant byte.
    clear: u32,
    /// Unique stream-read authority, expired immediately after render returns.
    invocation: u64,
    /// Exact bounded number of contributions in painter order.
    block_count: u32,
}

#[version(1)]
/// Owned sealed contributions readable only during one active synchronous submission.
interface IRenderStream {
    /// Observes a block without manufacturing another public resource owner.
    /// Invalid indices and expired invocations reject; the renderer authenticates private provenance.
    fn view(&self, invocation: u64, block: u32) -> Result<WeakComBox<IRenderViewBlock>>;
}

#[version(1)]
/// Device accepts only complete generic graphics blocks, with no UI layout or atlas state.
interface IRenderer {
    /// Prepares all resources before target acquisition, executes in order and explicitly submits.
    /// A failed frame must not present; already executed immediate operations cannot be rolled back.
    fn render(&self, info: RenderInfo, stream: &IRenderStream) -> Result<()>;
}

#[version(1)]
/// Normalized source rectangle for one immutable texture; every edge lies in the unit square.
struct TextureRegion {
    /// Left source edge.
    u0: f32,
    /// Top source edge.
    v0: f32,
    /// Right source edge, no smaller than u0.
    u1: f32,
    /// Bottom source edge, no smaller than v0.
    v1: f32,
}
