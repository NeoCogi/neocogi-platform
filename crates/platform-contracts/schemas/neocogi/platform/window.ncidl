#[version(1)]
/// Native window and event-pump capability with no exposed toolkit or graphics handles.
interface IPlatformWindow {
    /// Returns a separate trusted graphics assembly object. It retains native graphics lifetime
    /// without exposing this window, input registrations, window renderer or ordinary image-upload factory by QI.
    /// Trusted group/surface assembly remains available through the host's separate factory projections.
    fn graphics_host(&self) -> Result<ComPtr<IRenderHost>>;
    /// Creates a separate narrow clipboard identity safe to delegate to widget services.
    /// QueryInterface on this result cannot recover this window or its renderer/factories.
    fn clipboard(&self) -> Result<ComPtr<ITextClipboard>>;
    /// Returns current drawable dimensions in physical pixels, including device scaling and resize.
    /// Query before recording each frame; use the same value for drawing bounds and RenderInfo.size.
    /// A zero component suspends rendering; the original window request is not the submitted pixel extent.
    fn size(&self) -> Result<Size>;
    /// Removes one relevant transition and borrows the destination for synchronous delivery.
    /// A failed delivery consumes the attempted event; later events remain queued. Recursive
    /// polling of this window returns Busy. The destination is never retained by the platform.
    fn poll(&self, destination: &IInputSink) -> Result<PollStatus>;
    /// Enables or disables native text input and positions composition UI after a UI update.
    /// Calling repeatedly with the same editable focus preserves an active composition.
    fn text_input(&self, area: TextInputArea) -> Result<()>;
}

#[version(1)]
/// Exclusive result of one window construction, with no shared diagnostic dependency.
interface IWindowCreationResult: IRenderOutcome {
    /// Transfers a fully constructed shareable window once; dropping an untaken result closes it.
    fn take_window(&mut self) -> Result<ComPtr<IPlatformWindow>>;
}

#[version(1)]
/// Constructible platform root for typed system services and independent native windows.
interface Platform {
    /// Queries the audio implementation and application PCM profile without opening a microphone or window.
    fn audio_capabilities(&self) -> Result<ComPtr<IAudioCapabilities>>;
    /// Opens the default PCM playback or capture device independently of windows and graphics.
    /// Browser capture requests permission asynchronously. A ready stream starts paused.
    fn open_audio(&self, direction: AudioDirection, config: AudioConfig) -> Result<ComBox<IAudioOpenRequest>>;
    /// Creates an independent native window and graphics device without UI assets.
    /// Construction detail belongs to the returned report, never to shared platform state.
    fn create_window_result(
        &self,
        title: &[u8],
        size: Size,
    ) -> Result<ComBox<IWindowCreationResult>>;
}

#[version(1)]
/// Completion of one bounded clipboard operation; implementations may deliver asynchronously.
interface IClipboardCompletion {
    /// Status is zero on success or a failing NcStatus code. Successful reads supply UTF-8 at
    /// offset zero; writes and failures supply empty text. The recipient queues this copied fact.
    fn complete(&self, status: i32, text: &[u8]) -> Result<()>;
}

#[version(1)]
/// System text clipboard independent of SDL, DOM, and widget ownership.
interface ITextClipboard {
    /// Retains the completion until exactly one success/failure is delivered, or fails immediately.
    /// Reading may require browser permission; no callback borrows a UI traversal.
    fn read(&self, completion: &IClipboardCompletion) -> Result<()>;
    /// Copies bounded UTF-8 text before returning. A successful completion means the platform
    /// accepted the write; callers must wait for that receipt before removing cut text.
    fn write(&self, text: &[u8], completion: &IClipboardCompletion) -> Result<()>;
}
