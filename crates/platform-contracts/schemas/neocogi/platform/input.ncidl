#[version(1)]
/// Integer point or delta in drawable or UI-local coordinates documented by its caller.
struct Point {
    /// Horizontal coordinate or displacement.
    x: i32,
    /// Vertical coordinate or displacement.
    y: i32,
}

#[version(1)]
/// Logical keyboard identity normalized independently of native scan codes.
enum KeyCode: u8 {
    /// Printable shortcut key carrying a Unicode scalar, validated before delivery.
    /// Keypad +, -, * and / share the corresponding ordinary character identity.
    Character(u32),
    /// Removes the previous character.
    Backspace,
    /// Removes the next character.
    Delete,
    /// Primary activation or line break.
    Enter,
    /// Cancellation or popup dismissal.
    Escape,
    /// Space-bar activation, separate from committed text.
    Space,
    /// Sequential focus traversal.
    Tab,
    /// Insert editing command.
    Insert,
    /// Beginning of content or line.
    Home,
    /// End of content or line.
    End,
    /// Previous viewport.
    PageUp,
    /// Next viewport.
    PageDown,
    /// Upward navigation.
    ArrowUp,
    /// Downward navigation.
    ArrowDown,
    /// Leftward navigation.
    ArrowLeft,
    /// Rightward navigation.
    ArrowRight,
    /// Numbered function key in the inclusive range 1 through 24.
    Function(u8),
    /// Alt/Option itself, for distinguishing a tap from a chord.
    Alt,
    /// Control modifier itself.
    Control,
    /// Shift modifier itself.
    Shift,
    /// Command/Windows/Super modifier itself.
    Super,
}

#[version(1)]
/// A key release or press; repeat belongs only to a press.
enum KeyAction: u8 {
    /// A platform key-down transition, including operating-system repeats.
    Pressed {
        /// True only for an automatically repeated press.
        repeat: bool,
    },
    /// A key-up transition; releases cannot repeat.
    Released,
}

#[version(1)]
/// Complete logical key transition shared by platform producers and UI consumers.
struct KeyStroke {
    /// Logical key identity with only its applicable payload.
    key: KeyCode,
    /// Press or release, with repeat information only for presses.
    action: KeyAction,
    /// Complete modifier bits: Alt=1, Ctrl=2, Shift=4, Super=8.
    modifiers: u8,
}

#[version(1)]
/// Ordered native input before a UI implementation computes drag, hover, and local coordinates.
enum UiInput: u8 {
    /// Native focus or capture was lost; clears held state in input order.
    Cancel,
    /// Absolute pointer position in drawable coordinates.
    Pointer(Point),
    /// Button press at an absolute drawable position.
    Down {
        /// Current drawable position.
        position: Point,
        /// Buttons changed by this transition: left=1, right=2, middle=4.
        buttons: u8,
    },
    /// Button release at an absolute drawable position.
    Up {
        /// Current drawable position.
        position: Point,
        /// Buttons changed by this transition: left=1, right=2, middle=4.
        buttons: u8,
    },
    /// Wheel delta at the last committed pointer position, in physical pixels.
    /// Positive X moves right; positive Y moves down, after host natural-scroll normalization.
    Scroll(Point),
    /// Complete key identity, state, and modifiers.
    Key(KeyStroke),
    /// Complete UTF-8 commit supplied in the accompanying bounded text argument.
    Text,
}

#[version(1)]
/// Synchronous normalized-input destination implemented by a UI runtime or application adapter.
interface IInputSink {
    /// Copies one ordered event. Text requires complete UTF-8 at offset zero; every other event
    /// requires an empty text argument. The platform borrows this interface only during polling.
    fn input(&self, event: UiInput, text: &[u8]) -> Result<()>;
}

#[version(1)]
/// Outcome of removing one relevant native transition from a window's queue.
enum PollStatus: u8 {
    /// No relevant transition remains; update and render the accumulated input.
    Idle = 0,
    /// Input was delivered or drawable/window state changed; poll again before rendering.
    Event = 1,
    /// Application quit or this native window's close was requested.
    Close = 2,
}

#[version(1)]
/// Committed native text-input placement expressed in physical drawable pixels.
enum TextInputArea: u8 {
    /// No editable focus currently requests IME or text composition.
    None,
    /// Nonnegative editor rectangle; platforms convert it to logical OS or CSS coordinates.
    Area(Rect),
}
