/// Opaque retained identity of one compatible native driver instance; grants no device authority.
interface IRenderDriverIdentity {}

/// Read-only compatibility metadata. Providers still authenticate local resource provenance.
interface IRenderDriverBound {
    /// Stable process-local identity; independent devices/contexts return different tokens.
    fn driver_identity(&self) -> Result<ComPtr<IRenderDriverIdentity>>;
}

// Generic graphics resources and bounded CPU recording. Native objects never cross this ABI.
/// Immutable resource role; one public buffer owns either linear data or texture pixels.
enum GpuBufferRole: u8 {
    /// Vertex or instance attribute storage.
    Vertex,
    /// Unsigned element-index storage.
    Index,
    /// Shader uniform storage with explicitly declared portable packing.
    Uniform,
    /// Formatted two-dimensional sampled pixels.
    Texture,
}

/// Fixed creation/update policy, independent of native API memory flags.
enum GpuBufferUsage: u8 {
    /// Complete initial data is supplied once; uploads are forbidden.
    Static,
    /// Writes preserve bytes or pixels outside the selected range.
    Dynamic,
    /// Replacement writes select bounded reusable storage for overlapping frames.
    Streamed,
}

/// Programmable stages admitted by the portable graphics profile.
enum GpuShaderStage: u8 {
    /// Vertex processing.
    Vertex,
    /// Fragment color/depth processing.
    Fragment,
}

/// Little-endian unsigned elements in an index buffer.
enum GpuIndexFormat: u8 {
    /// Two-byte unsigned indices.
    U16,
    /// Four-byte unsigned indices.
    U32,
}

/// Explicit packed vertex formats, independent of Rust record layout.
enum GpuVertexFormat: u8 {
    /// One 32-bit float.
    Float32,
    /// Two 32-bit floats.
    Float32x2,
    /// Three 32-bit floats.
    Float32x3,
    /// Four 32-bit floats.
    Float32x4,
    /// One unsigned integer.
    Uint32,
    /// Two unsigned integers.
    Uint32x2,
    /// Three unsigned integers.
    Uint32x3,
    /// Four unsigned integers.
    Uint32x4,
    /// Four bytes normalized into floating-point channels.
    Unorm8x4,
}

/// Which draw index advances an attribute stream.
enum GpuStepMode: u8 {
    /// Advance for each vertex.
    Vertex,
    /// Advance for each instance.
    Instance,
}

/// Sampled texture formats in the portable profile.
enum GpuTextureFormat: u8 {
    /// Four linear normalized bytes.
    Rgba8Unorm,
    /// Four bytes with sRGB color transfer.
    Rgba8Srgb,
}

/// Sampling filter for one texture axis/magnification decision.
enum GpuFilter: u8 {
    /// Nearest texel.
    Nearest,
    /// Linear interpolation.
    Linear,
}

/// Behavior of sampled coordinates outside the unit square.
enum GpuAddressMode: u8 {
    /// Clamp to edge.
    Clamp,
    /// Repeat texels.
    Repeat,
    /// Mirror each repeated interval.
    Mirror,
}

/// Depth comparison against the current bounded attachment.
enum GpuCompare: u8 {
    /// Never comparison.
    Never,
    /// Less comparison.
    Less,
    /// Equal comparison.
    Equal,
    /// LessEqual comparison.
    LessEqual,
    /// Greater comparison.
    Greater,
    /// NotEqual comparison.
    NotEqual,
    /// GreaterEqual comparison.
    GreaterEqual,
    /// Always comparison.
    Always,
}

/// Primitive faces removed before rasterization.
enum GpuCullMode: u8 {
    /// Keep both orientations.
    None,
    /// Cull front faces.
    Front,
    /// Cull back faces.
    Back,
}

/// Front-facing winding after portable coordinate normalization.
enum GpuFrontFace: u8 {
    /// Counter-clockwise.
    Ccw,
    /// Clockwise.
    Cw,
}

/// Scalar or channel factor used by color/alpha blending.
enum GpuBlendFactor: u8 {
    /// Zero blend factor.
    Zero,
    /// One blend factor.
    One,
    /// SrcColor blend factor.
    SrcColor,
    /// OneMinusSrcColor blend factor.
    OneMinusSrcColor,
    /// DstColor blend factor.
    DstColor,
    /// OneMinusDstColor blend factor.
    OneMinusDstColor,
    /// SrcAlpha blend factor.
    SrcAlpha,
    /// OneMinusSrcAlpha blend factor.
    OneMinusSrcAlpha,
    /// DstAlpha blend factor.
    DstAlpha,
    /// OneMinusDstAlpha blend factor.
    OneMinusDstAlpha,
}

/// One color or alpha equation; only scaled arithmetic carries factors.
enum GpuBlendEquation: u8 {
    /// Source times src plus destination times dst.
    Add {
        /// Source scaling factor.
        src: GpuBlendFactor,
        /// Destination scaling factor.
        dst: GpuBlendFactor,
    },
    /// Source times src minus destination times dst.
    Subtract {
        /// Source scaling factor.
        src: GpuBlendFactor,
        /// Destination scaling factor.
        dst: GpuBlendFactor,
    },
    /// Destination times dst minus source times src.
    ReverseSubtract {
        /// Source scaling factor.
        src: GpuBlendFactor,
        /// Destination scaling factor.
        dst: GpuBlendFactor,
    },
    /// Component-wise minimum of unscaled source and destination.
    Min,
    /// Component-wise maximum of unscaled source and destination.
    Max,
}

/// Read-only shader inputs allowed by the graphics profile.
enum GpuBindingKind: u8 {
    /// A uniform block carrying its exact positive reflected byte length.
    Uniform(u32),
    /// A two-dimensional sampled texture and sampler pair.
    SampledTexture,
}

/// Exhaustive recording state; terminal states cannot add commands.
enum RenderViewState: u8 {
    /// Accepting bounded commands; remains unfinished if the client facade is dropped.
    Recording,
    /// First error retained until host expiry; cancellation and client Drop cannot erase it.
    Rejected,
    /// Complete immutable payload sealed for host harvest.
    Committed,
    /// Healthy recording explicitly cancelled; no contribution.
    Cancelled,
    /// Host invocation ended or payload already transferred.
    Expired,
}

/// Exact fixed shape; the variant determines the immutable binding role.
enum GpuBufferDesc {
    /// Vertex/instance attributes with an explicit pipeline-defined stride.
    Vertex {
        /// Fixed positive byte capacity; at most 64 MiB in the baseline profile.
        byte_len: u64,
    },
    /// Index elements whose u16/u32 interpretation is selected when binding.
    Index {
        /// Fixed positive byte capacity; at most 64 MiB in the baseline profile.
        byte_len: u64,
    },
    /// Explicit portable shader-uniform bytes.
    Uniform {
        /// Fixed positive byte capacity; at most 64 MiB in the baseline profile.
        byte_len: u64,
    },
    /// Formatted sampled pixels; the baseline profile supports one mip level.
    Texture {
        /// Positive physical texel extent.
        size: Size,
        /// Four-byte RGBA texel interpretation.
        format: GpuTextureFormat,
        /// Baseline resources support exactly one mip level.
        mip_count: u32,
    },
}

/// Immutable allocation information, shared by untyped and upper-layer typed buffers.
struct GpuBufferInfo {
    /// Fixed resource shape; changing capacity requires a new buffer.
    desc: GpuBufferDesc,
    /// Static, preserving dynamic, or replacement streaming writes.
    usage: GpuBufferUsage,
}

/// Sampled shape retained by internal texture captures and read-only metadata.
struct GpuTextureInfo {
    /// Positive physical texel extent.
    size: Size,
    /// Interpretation of four tightly packed channels.
    format: GpuTextureFormat,
    /// The baseline profile requires one mip.
    mip_count: u32,
}

/// Immutable filtering and addressing state.
struct GpuSamplerDesc {
    /// Minification filter.
    min_filter: GpuFilter,
    /// Magnification filter.
    mag_filter: GpuFilter,
    /// Horizontal addressing.
    address_u: GpuAddressMode,
    /// Vertical addressing.
    address_v: GpuAddressMode,
}

/// Source replacement or independent color and alpha blending.
enum GpuBlendState: u8 {
    /// Replace destination components directly with source components.
    Replace,
    /// Apply the selected equations independently to RGB and alpha.
    Blend {
        /// RGB equation.
        color: GpuBlendEquation,
        /// Alpha equation.
        alpha: GpuBlendEquation,
    },
}

/// Triangle-list graphics state plus exact source-array counts.
struct GpuPipelineInfo {
    /// Color/alpha blending.
    blend: GpuBlendState,
    /// RGBA write bits in the low four bits.
    color_write: u8,
    /// Write passing depth values.
    depth_write: bool,
    /// Depth comparison; Always with depth_write false disables depth effects.
    depth_compare: GpuCompare,
    /// Face culling.
    cull: GpuCullMode,
    /// Front-facing winding.
    front_face: GpuFrontFace,
    /// At most eight distinct stream slots.
    vertex_buffer_count: u32,
    /// At most sixteen distinct attribute locations.
    attribute_count: u32,
    /// Exact reflected stage/slot resource declarations.
    binding_count: u32,
}

/// One declared stream and its byte stepping rule.
struct GpuVertexBufferLayout {
    /// Stream slot below eight.
    slot: u32,
    /// Positive four-byte-aligned stride no greater than 252 bytes, portable to WebGL 2.
    stride: u32,
    /// Vertex or instance advancement.
    step: GpuStepMode,
}

/// One explicit attribute footprint within a stream.
struct GpuVertexAttribute {
    /// Shader input location below sixteen.
    location: u32,
    /// Declared stream slot.
    slot: u32,
    /// Packed source element format.
    format: GpuVertexFormat,
    /// Byte offset whose entire format fits inside stride.
    offset: u32,
}

/// Expected stage/slot resource class and reflected byte count.
struct GpuShaderBinding {
    /// Stage consuming this input.
    stage: GpuShaderStage,
    /// Uniform slot below four or texture slot below four.
    slot: u32,
    /// Uniform block with its reflected size, or sampled texture/sampler pair.
    kind: GpuBindingKind,
}

/// Host-authoritative root expressed in two coordinate spaces.
struct RenderViewRoot {
    /// Final visible client rectangle in that client's own drawing coordinates.
    client: Rect,
    /// Same region in logical target coordinates; extents must match.
    target: Rect,
}

/// Projection mapping and visibility are independent.
struct RenderViewInfo {
    /// Immutable visible root in client drawing coordinates.
    client: Rect,
    /// Current viewport in root-client-local coordinates.
    viewport: Rect,
    /// Effective clip in root-client-local coordinates.
    clip: Rect,
    /// Current local origin zero and viewport extents.
    bounds: Rect,
}

/// Host-created quotas shared by all factory observations.
struct RenderClientLimits {
    /// Live public GPU resource owners.
    resources: u32,
    /// Live immutable CPU/native version admission bytes.
    live_bytes: u64,
    /// Live command and uniform payload bytes.
    pending_bytes: u64,
    /// Attempted draws and regional clears per CPU frame, including automatic view initialization.
    frame_draws: u32,
    /// Attempted vertex/index work, including instance multiplication and clipped/zero-instance scans.
    frame_indices: u64,
    /// Live public view metadata owners, including expired shells.
    live_views: u32,
    /// Maximum client stack depth, including root; at most 64.
    stack_depth: u32,
}

/// Immutable permissions selected by application setup for one resource group.
/// These describe operations, not a widget/compositor/application role.
/// UI composition normally enables color writes, resource updates and imports, leaving all depth fields false.
/// Enabling a permission permits that operation; it does not change pipeline state automatically.
struct RenderClientPermissions {
    /// Permit explicit regional color clears; this does not clear the whole framebuffer on creation.
    clear_color: bool,
    /// Permit explicit regional depth clears when the selected surface has depth.
    clear_depth: bool,
    /// Permit draw pipelines with nonzero color write masks.
    write_color: bool,
    /// Permit draw pipelines that write depth when the selected surface has depth.
    write_depth: bool,
    /// Permit depth comparisons other than Always when the selected surface has depth.
    read_depth: bool,
    /// Permit dynamic/streamed writes; immutable initialized creation remains allowed without it.
    write_resources: bool,
    /// Permit the host to import an authenticated existing image into this group's resource factory.
    import_images: bool,
    /// Clear this group's recorded view rectangle to depth one before its first command; requires clear_depth.
    initialize_depth: bool,
}

/// Exclusive persistent resource with synchronous copied transfers and fixed capacity.
interface IGpuBuffer: IRenderDriverBound {
    /// Returns immutable shape and usage established at creation.
    fn info(&self) -> Result<GpuBufferInfo>;
    /// Copies input bytes at the slice's logical byte offset before returning.
    /// Textures use tightly packed row-major RGBA bytes, with no native row padding.
    /// Static/imported buffers reject writes. Dynamic preserves unselected bytes;
    /// streamed clears them. Busy leaves the published contents unchanged and
    /// never allocates another slot. An empty upload is a checked no-op.
    fn upload(&mut self, data: &[u8]) -> Result<()>;
    /// Copies exactly output capacity bytes from its logical byte offset.
    /// Reads the published CPU contents, not GPU readback; native-only imports
    /// reject. Bounds are checked before any output is written. Empty reads at
    /// capacity are valid. No pointer or borrow survives either transfer call.
    fn read(&self, output: &mut [u8]) -> Result<()>;
}

/// Optional upper-layer specialization; drivers never instantiate application types.
/// The wrapper owns the original driver buffer and validates T's GPU packing.
interface ITypedGpuBuffer<T>: IGpuBuffer {
    /// Logical element capacity; textures count four-byte texels in row-major order.
    fn element_count(&self) -> Result<u64>;
    /// Explicit GPU byte stride; COM layout alone does not establish shader packing.
    fn element_stride(&self) -> Result<u64>;
    /// Original registered resource; inheritance does not change wrapper identity.
    fn underlying_buffer(&self) -> Result<WeakComBox<IGpuBuffer>>;
    /// Synchronous typed upload; the slice's logical offset counts elements.
    fn upload_elements(&mut self, data: &[T]) -> Result<()>;
    /// Synchronous typed read; output offset and capacity count elements.
    /// Every requested element is copied or the call fails without publishing output.
    fn read_elements(&self, output: &mut [T]) -> Result<()>;
}

/// Exclusive immutable sampler state.
interface IGpuSampler: IRenderDriverBound {}

/// Exclusive validated portable shader; pipelines retain private artifact snapshots.
interface IGpuShader: IRenderDriverBound {}

/// Exclusive logical graphics pipeline with private target-compatible native variants.
interface IGpuPipeline: IRenderDriverBound {}

/// Immutable bounded CPU bytes copied synchronously before logical publication.
interface IGpuDataSource {
    /// Exact total byte length.
    fn byte_count(&self) -> Result<u64>;
    /// Initialize exactly the requested offset/capacity; short successful prefixes reject.
    fn read(&self, output: &mut [u8]) -> Result<()>;
}

/// Copied pipeline header and bounded typed layout declarations.
interface IGpuPipelineSource {
    /// Returns fixed state and exact array lengths.
    fn info(&self) -> Result<GpuPipelineInfo>;
    /// Copies stream layouts at the requested element offset.
    fn vertex_buffers(&self, output: &mut [GpuVertexBufferLayout]) -> Result<()>;
    /// Copies attribute layouts at the requested element offset.
    fn attributes(&self, output: &mut [GpuVertexAttribute]) -> Result<()>;
    /// Copies stage resource declarations at the requested element offset.
    fn bindings(&self, output: &mut [GpuShaderBinding]) -> Result<()>;
}

/// Exclusive operation result retaining either a shader owner or a bounded immutable failure.
interface IShaderCreationResult: IRenderOutcome {
    /// Transfers the complete shader exactly once after successful status; subsequent takes reject.
    /// Dropping an untaken successful result releases the shader normally. Failed results stay readable.
    fn take_shader(&mut self) -> Result<ComBox<IGpuShader>>;
}

/// Exclusive operation result retaining either an imported texture owner or an owned failure.
interface ITextureImportResult: IRenderOutcome {
    /// Transfers the imported logical resource once; failure retains no partial public resource.
    fn take_texture(&mut self) -> Result<ComBox<IGpuBuffer>>;
}

/// Restricted shareable factory; all created GPU resource owners are exclusive.
interface IRenderResources: IRenderDriverBound {
    /// Creates immutable initialized storage. Supplied bytes must exactly match the shape.
    fn create_static_buffer(&self, desc: GpuBufferDesc, data: &IGpuDataSource) -> Result<ComBox<IGpuBuffer>>;
    /// Creates fixed initialized capacity with no caller-supplied data; writes preserve other contents.
    fn create_dynamic_buffer(&self, desc: GpuBufferDesc) -> Result<ComBox<IGpuBuffer>>;
    /// Creates bounded reusable capacity with no caller-supplied data; never allocates on a map miss.
    fn create_streamed_buffer(&self, desc: GpuBufferDesc) -> Result<ComBox<IGpuBuffer>>;
    /// Create immutable portable filtering state.
    fn create_sampler(&self, desc: GpuSamplerDesc) -> Result<ComBox<IGpuSampler>>;
    /// Validate WGSL graphics profile and retain CPU artifacts for one UTF-8 entry point.
    fn create_shader_result(&self, stage: GpuShaderStage, code: &IGpuDataSource, entry: &[u8]) -> Result<ComBox<IShaderCreationResult>>;
    /// Capture live shader artifacts and validate the complete pipeline layout.
    fn create_pipeline(&self, desc: &IGpuPipelineSource, vertex: &IGpuShader, fragment: &IGpuShader) -> Result<ComBox<IGpuPipeline>>;
}

/// Invocation-bound exclusive graphics recorder; every operation checks its private lease.
interface IRenderView {
    /// Report root, projection mapping and visible clip separately.
    fn info(&self) -> Result<RenderViewInfo>;
    /// Push a contained child viewport without refitting to its clip.
    fn push_view(&mut self, local: Rect) -> Result<RenderViewInfo>;
    /// Narrow raster visibility without changing projection mapping.
    fn push_clip(&mut self, local: Rect) -> Result<()>;
    /// Restore the preceding stack entry; root underflow rejects.
    fn pop(&mut self) -> Result<()>;
    /// Restore root view/clip and stack depth; retain bindings, attachment depth and charges.
    fn reset(&mut self) -> Result<()>;
    /// Install a weakly observed pipeline binding.
    fn bind_pipeline(&mut self, pipeline: &IGpuPipeline) -> Result<()>;
    /// Install a vertex/instance stream; role and ranges are validated at draw admission.
    fn bind_vertex_buffer(&mut self, slot: u32, buffer: &IGpuBuffer, offset: u64) -> Result<()>;
    /// Install an index stream with explicit little-endian element format.
    fn bind_index_buffer(&mut self, buffer: &IGpuBuffer, format: GpuIndexFormat, offset: u64) -> Result<()>;
    /// Install a sampled texture/sampler pair in a stage slot.
    fn bind_texture(&mut self, stage: GpuShaderStage, slot: u32, texture: &IGpuBuffer, sampler: &IGpuSampler) -> Result<()>;
    /// Observe fixed uniform storage; draws capture its selected completed write and exact range.
    fn bind_uniform_buffer(&mut self, stage: GpuShaderStage, slot: u32, buffer: &IGpuBuffer, offset: u64, byte_len: u64) -> Result<()>;
    /// Capture live bindings, current versions and uniforms for a non-indexed triangle draw.
    fn draw(&mut self, vertices: u32, instances: u32, first_vertex: u32) -> Result<()>;
    /// Capture and validate all indexed vertex/instance ranges; base vertex and first instance are zero.
    fn draw_indexed(&mut self, indices: u32, instances: u32, first_index: u32) -> Result<()>;
    /// Replace color only inside the effective clip.
    fn clear_color(&mut self, rgba: u32) -> Result<()>;
    /// Replace finite normalized depth only inside the effective clip.
    fn clear_depth(&mut self, depth: f32) -> Result<()>;
    /// Seal a balanced complete payload exactly once; never submits or presents.
    fn finish(&mut self) -> Result<()>;
    /// Cancel healthy recording and release pending storage without refunding attempted work.
    /// Preserve rejection, commitment and expiry. Client Drop does not imply cancellation.
    fn cancel(&mut self) -> Result<()>;
}

/// Host-owned sealed CPU commands; canonical identity recovers private immutable snapshots.
interface IRenderViewBlock {
}

/// Host-only owner of one revocable pending payload; never exposed by client QI.
interface IRenderViewSession {
    /// Transfer one exclusive client view at most once.
    fn view(&mut self) -> Result<ComBox<IRenderView>>;
    /// Inspect exhaustive session state.
    fn state(&self) -> Result<RenderViewState>;
    /// Move committed payload once; expire the client facade.
    fn take_block(&mut self) -> Result<ComBox<IRenderViewBlock>>;
    /// Revoke access and release all unmoved storage, including unfinished dropped-client work.
    fn expire(&mut self) -> Result<()>;
}

/// Trusted CPU traversal lifetime; cumulative domain charges survive sequential views.
interface IRenderRecordingFrame {
    /// Authenticate the factory and create a host session for committed root geometry.
    fn begin_view(&mut self, root: RenderViewRoot, resources: &IRenderResources) -> Result<ComBox<IRenderViewSession>>;
    /// End CPU recording only after all sessions were harvested, expired or explicitly cancelled.
    /// Unfinished and rejected sessions fail this call; it never submits.
    fn finish(&mut self) -> Result<()>;
    /// Abandon unfinished sessions on error even when no GPU submission occurs.
    fn abort(&mut self) -> Result<()>;
}

/// Trusted CPU recording bridge; it grants no native frame acquisition or presentation.
/// Applications may install it in a UI runtime while delegating only bounded views to widgets.
interface IRenderViewBroker {
    /// Start one CPU traversal with fresh attempted-work counters.
    fn begin_frame(&self) -> Result<ComBox<IRenderRecordingFrame>>;
}

/// Exclusive host-only admission controller, on a different identity from its factory.
interface IRenderClientDomain {
    /// Delegate only this restricted shareable factory to clients.
    fn resources(&self) -> Result<ComPtr<IRenderResources>>;
    /// Close new admission while captured and in-flight storage retires normally.
    fn close(&mut self) -> Result<()>;
}

/// Application-owned factory for independently limited resource groups bound to an authenticated drawing target.
interface IRenderClientFactory: IRenderDriverBound {
    /// Bind a new group to this device's surface with explicit drawing, update and import permissions.
    /// Only application setup receives this factory; clients receive the resulting restricted resources.
    /// Groups can share a target without sharing resources or quotas. A foreign surface returns RENDER_E_OWNER;
    /// inconsistent permissions (including depth on a color-only image) return NC_E_INVALID_ARG.
    fn create_client(
        &self,
        limits: RenderClientLimits,
        surface: &IRenderSurface,
        permissions: RenderClientPermissions,
    ) -> Result<ComBox<IRenderClientDomain>>;
}

/// Trusted host-only assembly capability; never delegated to widgets.
interface IRenderHost: IRenderDriverBound {
    /// Observe completed work and reclaim retired storage before quota-sensitive creation.
    /// No target is acquired, cleared or presented; incomplete work remains owned and charged.
    fn maintain_result(&self) -> Result<ComPtr<IRenderOutcome>>;
    /// Import an authenticated immutable image when this group's creation permissions allow it.
    /// Same-device and exact-group ownership remain mandatory; no native handle or image editing is exposed.
    fn import_texture_result(&self, resources: &IRenderResources, image: &ITexture) -> Result<ComBox<ITextureImportResult>>;
    /// Complete fallible preparation of a permitted imported image before the caller publishes its resource revision.
    /// This never acquires a target or invokes a client during native execution.
    fn prepare_texture_result(&self, resources: &IRenderResources, texture: &IGpuBuffer) -> Result<ComPtr<IRenderOutcome>>;
    /// Creates a narrow CPU recording broker for one host-controlled drawing traversal.
    fn recording_broker(&self) -> Result<ComPtr<IRenderViewBroker>>;
}
