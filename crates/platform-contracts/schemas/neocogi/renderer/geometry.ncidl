/// Canonical copied pixel dimensions shared by platform, GFX, and renderer contracts.
struct Size {
    /// Horizontal extent in pixels.
    width: i32,
    /// Vertical extent in pixels.
    height: i32,
}

/// Copied axis-aligned rectangle in the coordinate system documented by its caller.
struct Rect {
    /// Horizontal origin.
    x: i32,
    /// Vertical origin.
    y: i32,
    /// Nonnegative horizontal extent.
    width: i32,
    /// Nonnegative vertical extent.
    height: i32,
}

/// Simple RGBA color stored with independently addressable 8-bit components.
/// Persistence uses the ordinary ordered NCB fields; the former sequence policy is retired.
struct Color {
    /// Red channel.
    r: u8,
    /// Green channel.
    g: u8,
    /// Blue channel.
    b: u8,
    /// Alpha channel.
    a: u8,
}
