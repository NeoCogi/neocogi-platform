#[version(1)]
/// Immutable bounded CPU image containing tightly packed row-major RGBA pixels.
///
/// The capability carries only graphics data. In particular, it exposes no UI
/// font, icon, skin, chrome, palette, or catalog metadata to renderer plugins.
interface IRgbaImage {
    /// Returns positive immutable pixel dimensions.
    fn size(&self) -> Result<Size>;
    /// Copies the exact requested byte range from tightly packed RGBA storage.
    fn pixels(&self, output: &mut [u8]) -> Result<()>;
}

#[version(1)]
/// Immutable GPU pixels retain only their native allocation and creating physical device/context.
/// Final native use retires through driver maintenance, or owned cleanup after driver shutdown.
interface ITexture: IRenderDriverBound {
    /// Returns positive immutable pixel dimensions, independent of its destination rectangle.
    fn size(&self) -> Result<Size>;
}

#[version(1)]
/// Optional renderer capability for uploading immutable external images.
interface ITextureFactory: IRenderDriverBound {
    /// Some copies exact tightly packed RGBA; None creates initialized transparent-black pixels.
    fn create_texture(&self, size: Size, pixels: &Option<ComPtr<IGpuDataSource>>) -> Result<ComPtr<ITexture>>;
}

#[version(1)]
/// Selects an existing framebuffer view or a separately rendered immutable image.
enum RenderSurfaceKind: u8 {
    /// Commands join the creating window's ordered frame; this view never clears or presents it.
    Framebuffer,
    /// Each successful independent submission publishes a fresh immutable color image.
    Image,
}

#[version(1)]
/// Surface construction on the factory's device; no native attachment is exposed.
struct RenderSurfaceDesc {
    /// Framebuffer view or independent image target.
    kind: RenderSurfaceKind,
    /// Image dimensions, including zero for suspension; framebuffer views require zero and follow the window.
    size: Size,
}

#[version(1)]
/// Selected drawing target shared by independently owned resource groups.
/// Framebuffer views are recorded through IRenderRecordingFrame and submitted by the window's renderer.
/// Image surfaces additionally expose IRenderer for independent image submission.
/// Releasing this capability does not change targets retained by existing groups or completed immutable images.
interface IRenderSurface: IRenderDriverBound {
    /// Returns the immutable target kind established by its trusted factory.
    fn kind(&self) -> Result<RenderSurfaceKind>;
    /// Framebuffer views report the window's current physical pixel size; images report their requested size.
    fn size(&self) -> Result<Size>;
    /// Changes future image dimensions without mutating completed images; framebuffer views reject resizing.
    fn resize(&self, size: Size) -> Result<()>;
    /// Last successfully completed image; framebuffer views and never-rendered image surfaces return NC_E_NOT_FOUND.
    fn completed_image(&self) -> Result<ComPtr<ITexture>>;
}

#[version(1)]
/// Creates image targets and views of this window's framebuffer without acquiring a frame.
interface IRenderSurfaceFactory: IRenderDriverBound {
    /// Framebuffer views expose no independent renderer and never allocate, clear or present a replacement target.
    /// Image surfaces preserve completed images across subsequent rendering, resize and failed submissions.
    /// Unknown wire-enum tags return NC_E_INVALID_TAG at the generated ABI boundary. Nonzero framebuffer
    /// sizes and negative image extents return NC_E_INVALID_ARG; all extents validate before publication.
    fn create_surface(&self, desc: RenderSurfaceDesc) -> Result<ComPtr<IRenderSurface>>;
}

#[version(1)]
/// Immutable status/text belonging to one completed operation, never a shared device error slot.
interface IRenderOutcome {
    /// Original operation status; zero/nonnegative means success. This getter's own error is transport failure.
    fn status(&self) -> Result<i32>;
    /// Independently owned UTF-8 text for this result only, bounded to 4096 bytes; empty on success.
    fn message(&self) -> Result<ComPtr<INcString>>;
}

#[version(1)]
/// Owned diagnostic snapshots preserve backend details without exposing backend-dependent errors.
interface IRenderDiagnostics {
    /// Returns the most recent failed GPU operation's detail, or empty text before a failure.
    fn diagnostic(&self) -> Result<ComPtr<INcString>>;
}
